# ============================================================
# .gitignore —— 告诉 git 哪些文件/目录不纳入版本控制
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.ipynb_checkpoints/

# ---- 运行时产物 ----
logs/
*.log

# ---- BI 复核临时产物（OCR/截图，确认后可整目录删除，不进库）----
_bi_review/

# ---- FineBI 看板导出 PDF（可重新导出；如需保留导出证据，删掉下面这行）----
bl/*.pdf

# ---- 系统垃圾 ----
.DS_Store
Thumbs.db
desktop.ini
