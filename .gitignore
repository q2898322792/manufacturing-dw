# ============================================================
# .gitignore —— 告诉 git 哪些文件/目录不纳入版本控制
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.ipynb_checkpoints/

# ---- 运行时产物 ----
logs/
*.log

# ---- BI 复核临时产物（OCR/截图，确认后可整目录删除，不进库）----
_bi_review/

# ---- FineBI 看板导出 PDF（可重新导出；如需保留导出证据，删掉下面这行）----
bl/*.pdf

# ---- 系统垃圾 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器本地配置（VS Code 自动生成）----
.vscode/

# ---- Agent 工作记忆（WorkBuddy 等工具的本地日志；本地保留，不进仓库）----
.workbuddy/

# ---- 临时/备份文件 ----
*.bak
*.bak-*
*.orig
*~

# ---- 本地保留、不上传（个人笔记 / 简历评估等）----
# 文件仍在本机，只是不进版本库；如需公开，删掉下面这行
docs/项目评估与优化路线图.md
